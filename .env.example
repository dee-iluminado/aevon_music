# Public origin used for canonical URLs, robots.txt, the sitemap and OG tags.
# On Vercel this can be left unset — VERCEL_PROJECT_PRODUCTION_URL is used.
# Locally it falls back to http://localhost:3001.
NEXT_PUBLIC_SITE_URL=https://aevon-music.vercel.app

