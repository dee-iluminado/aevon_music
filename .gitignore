# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local artifacts
server.log
*.log

# android build artifacts (source stays tracked, the cache is 285 MB)
aevon-music-android/.cache/
aevon-music-android/.gradle/
aevon-music-android/build/
aevon-music-android/app/build/
aevon-music-android/.idea/
aevon-music-android/local.properties
aevon-music-android/**/*.apk
aevon-music-android/**/*.aab

# next.js agent files (regenerated by `next dev`)


.vercel
